# ── LLM provider ──────────────────────────────────────────────────────────────
# Which backend to use: "groq" (cloud, default) or "ollama" (local).
LLM_PROVIDER=groq

# Groq (cloud) — create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (local fallback) — requires `ollama serve` running with the model pulled.
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# ── PDF handling ──────────────────────────────────────────────────────────────
# Reject resume downloads larger than this many megabytes.
MAX_PDF_MB=20

# ── core-service (resume generator) ───────────────────────────────────────────
# Where the AI service reaches core-service to fetch a talent's full profile.
CORE_SERVICE_BASE_URL=http://localhost:8080
# Shared secret for internal server-to-server calls. MUST match core-service's
# service.internal-token (INTERNAL_SERVICE_TOKEN). Sent as the X-Service-Token header.
INTERNAL_SERVICE_TOKEN=dev-internal-token

# ── LaTeX compilation (.tex -> PDF) ───────────────────────────────────────────
# How to compile the assembled resume .tex into a PDF:
#   false (default) = OFFLINE: a local engine. Fast (~4s) and no per-request
#                     network. Install it once: powershell -ExecutionPolicy Bypass
#                     -File scripts/install_tectonic.ps1  (downloads Tectonic into
#                     AI/tools/). The first compile also caches its package bundle.
#   true            = ONLINE: the hosted LaTeX.Online service. No local install,
#                     but a third-party network dependency and slow (~25s on a miss).
RESUME_LATEX_PARSER_ONLINE=false

# Offline mode: leave empty to use the vendored AI/tools/tectonic.exe, or point at
# a system tectonic/pdflatex on PATH.
LATEX_LOCAL_COMMAND=
LATEX_LOCAL_TIMEOUT=60

# Online mode: LaTeX.Online endpoint.
LATEX_COMPILE_URL=https://latexonline.cc/compile
LATEX_COMPILE_TIMEOUT=90

# ── HTTP server ───────────────────────────────────────────────────────────────
# Port the FastAPI pipeline service listens on:
#   uvicorn app.main:app --host 0.0.0.0 --port 8000
# core-service calls it at POST /pipeline/v1/evaluate (see ai.service.base-url).
PORT=8000
