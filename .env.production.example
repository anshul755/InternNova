# InternNova — Production Environment Variables
# Copy this file to .env and replace all placeholder values.
# WARNING: .env contains SECRETS — never commit it to git.

# ── Domain & CORS ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://internnova.pages.dev,https://www.internnova.com,https://api.internnova.com

# ── MongoDB Atlas (Free M0 cluster) ────────────────────────────────────────────
# Get this from: Atlas dashboard → Connect → Drivers → connection string
# Or for self-hosted: mongodb://mongodb:27017/internnova-prod
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority&appName=InternNova-Prod
MONGODB_DB_NAME=internnova-prod

# ── JWT Secrets ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=<generate-with-openssl-rand-base64-48>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-base64-48>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Internal service-to-service token ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
# MUST match between core-service (service.internal-token) and ai-service (INTERNAL_SERVICE_TOKEN)
INTERNAL_SERVICE_TOKEN=<generate-with-openssl-rand-base64-32>

# ── SMTP (Gmail App Password) ──────────────────────────────────────────────────
# 1. Enable 2FA on your Gmail account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=<gmail-app-password-16-chars>
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true
EMAIL_FROM="InternNova <no-reply@internnova.com>"
MAIL_FORCE_CONFIGURED_FROM=false

# ── Cloudinary ─────────────────────────────────────────────────────────────────
# Get from: Cloudinary Dashboard → Account Details
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ── AI / LLM ───────────────────────────────────────────────────────────────────
# Groq cloud API (default): https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b

# Ollama local (optional fallback):
# OLLAMA_API_KEY=
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
