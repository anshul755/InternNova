# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ── MongoDB ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/internnova-dev
MONGODB_DB_NAME=internnova-dev

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_to_a_very_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_to_another_very_long_random_secret_at_least_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── SMTP (Nodemailer) ─────────────────────────────────────────────────────
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=InternNova
# EMAIL_FROM_ADDR=your-email@gmail.com  (defaults to SMTP_USER if unset)

FRONTEND_URL=https://internnova.com
# EMAIL_LOGO_URL=  (custom logo URL, defaults to InternNova hosted logo)

# ── CORS ──────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=./logs
